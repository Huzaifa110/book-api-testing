    {
      "name": "Display Available Books",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();\r",
              "const availableBooks = response.filter((book) => book.available === true);\r",
              "\r",
              "const unavaiableBooks = response.filter((book) => book.available === false);\r",
              "\r",
              "\r",
              "pm.test(\"Book Found\", () => {\r",
              "    pm.expect(availableBooks[0]).to.be.an('object');\r",
              "    pm.expect(availableBooks[0].available).to.be.true;\r",
              "    pm.expect(availableBooks[0].type)\r",
              ".to.eql('fictioin')});"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
      ],
