          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "const response = pm.response.json();\r",
              "\r",
              "console.log(response.status);\r",
              "\r",
              "pm.test(\"Status must be OK\", () => {\r",
              "    pm.expect(response.status).to.eql(\"NOT OK\");\r",
